    "fflate": "0.8.2",
    "lucide": "^0.460.0",
    "three": "^0.170.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/three": "^0.170.0",
    "@types/ws": "8.18.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}

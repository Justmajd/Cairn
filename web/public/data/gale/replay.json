 "event": {
  "title": "20 May 2024 solar particle event",
  "summary": "A far-side X-class flare and a fast halo CME sent energetic particles to Mars. Curiosity's RAD recorded its largest particle surge since landing.",
  "nasaReportedTotalUGy": 8100.0,
  "nasaStatement": "NASA/JPL, 10 June 2024: an astronaut standing next to Curiosity would have received 8,100 micrograys, comparable to 30 chest X-rays.",
